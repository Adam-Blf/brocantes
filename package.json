{
  "name": "brocantes",
  "version": "0.3.0",
  "private": true,
  "description": "Recense les brocantes et vide-greniers du Val-de-Marne et de Paris",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "node -e \"const{rmSync}=require('fs');try{rmSync('.next',{recursive:true,force:true,maxRetries:5,retryDelay:300})}catch(e){console.error('SUPPRESSION INCOMPLETE :',e.message);process.exit(1)}console.log('.next supprime')\"",
    "rebuild": "npm run clean && npm run build"
  },
  "dependencies": {
    "maplibre-gl": "^6.9.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
